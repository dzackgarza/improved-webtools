source_up_if_exists
dotenv_if_exists .env

# Required: SearxNG instance URL for web search
# export SEARXNG_INSTANCE_URL="http://searxng.local"

# Optional: Cache settings for webfetch
export WEBFETCH_CACHE_ENABLED="1"
export WEBFETCH_CACHE_DIR="$HOME/.cache/opencode-webfetch"
export WEBFETCH_CACHE_TTL_DAYS="90"

# Optional: Handler-specific settings
export WEBFETCH_ARXIV_LIBRARY_DIR="$HOME/.cache/opencode-arxiv-library"
export REDDIT_APIFY_ACTOR="spry_wholemeal/reddit-scraper"
export WIKIPEDIA_API_USER_AGENT="opencode-improved-webfetch/1.0 (plugin)"
