source_up
dotenv_if_exists .env

# Optional repo-local overrides or secrets live in .env.

# Required in .env when using a custom SearxNG instance for web search:
# SEARXNG_INSTANCE_URL=http://searxng.local

# Optional: Opencode configuration path
# Default: real shadowing mode (`webfetch`, `websearch`)
export OPENCODE_CONFIG="$PWD/.config/opencode.json"
export OPENCODE_CONFIG_DIR="$PWD/.config"
export IMPROVED_WEBTOOLS_TEST_PASSPHRASE="WEBTOOLS-PROBE-99"

# Manual debug mode: non-shadowing aliases (`webfetch_debug`, `websearch_debug`)
# IMPROVED_WEBTOOLS_DEBUG_MODE=1
# OPENCODE_CONFIG="$PWD/.config/opencode.debug.json"

# Optional: Cache settings for webfetch
export WEBFETCH_CACHE_ENABLED="1"
export WEBFETCH_CACHE_DIR="$HOME/.cache/opencode-webfetch"
export WEBFETCH_CACHE_TTL_DAYS="90"

# Optional: Handler-specific settings
export WEBFETCH_ARXIV_LIBRARY_DIR="$HOME/.cache/opencode-arxiv-library"
export REDDIT_APIFY_ACTOR="spry_wholemeal/reddit-scraper"
export WIKIPEDIA_API_USER_AGENT="opencode-improved-webfetch/1.0 (plugin)"

# Optional: YouTube-specific settings
# YTDLP_COOKIES_FILE=/abs/path/to/youtube.cookies
# YOUTUBE_VERIFY_TIMEOUT_MS=60000
